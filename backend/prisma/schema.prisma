datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Prescription {
  id          Int      @id @default(autoincrement())
  patientName String
  patientPhone String
  imageUrl    String
  latitude    Float
  longitude   Float
  status      String   @default("pending") // pending, accepted, collecting, processing, completed
  centerId    Int?     // Assigned center
  center      DiagnosticCenter? @relation(fields: [centerId], references: [id])
  age          Int?
  gender       String?
  paymentStatus String   @default("pending") // pending, paid, partial
  totalAmount  Float     @default(0)
  selectedServices Service[]
  reportUrl   String?  // Digital report path
  createdAt   DateTime @default(now())
}

model DiagnosticCenter {
  id          Int       @id @default(autoincrement())
  generatedId String    @unique // TTL-XXXX
  name        String
  ownerName   String    @default("")
  email       String    @default("")
  password    String
  latitude    Float
  longitude   Float
  phoneNumber String
  address     String    @default("")
  googleMapUrl String   @default("")
  
  // Compliance Info
  isoNumber    String?
  nablNumber   String?
  gstNumber    String?
  tradeLicense String?
  
  // Document Paths
  isoCertificate String?
  nablCertificate String?
  
  providesEmergency Boolean @default(false)
  
  isVerified  Boolean   @default(false)
  services    Service[]
  prescriptions Prescription[]
}

model Service {
  id          Int              @id @default(autoincrement())
  name        String           // e.g. USG, X-Ray
  code        String           @default("")
  category    String           @default("")
  subCategory String           @default("")
  price       Float            @default(0)
  costPrice   Float            @default(0)
  offerPrice  Float            @default(0)
  discountPercent Float        @default(0)
  tat         String           @default("")
  specimen    String           @default("")
  preparation String           @default("")
  description String           @default("")
  homeCollection Boolean       @default(false)
  homeVisitFee Float           @default(0)
  status      String           @default("Active")
  demand      Int              @default(0)
  profitMargin Float           @default(0)
  
  // Extended configuration fields (stored as JSON strings for complex types)
  parameterCount Int           @default(0)
  parameters     String        @default("[]")
  symptoms       String        @default("[]")
  availableDays  String        @default("[]")
  timeSlots      String        @default("{}")
  preTestInstructions String   @default("")
  geofence       String        @default("")
  homeCollectionHours String   @default("")
  collectionTime String        @default("")
  
  centerId    Int
  center      DiagnosticCenter @relation(fields: [centerId], references: [id])
  prescriptions Prescription[]
}
